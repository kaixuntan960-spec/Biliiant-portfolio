import { useEffect, useMemo, useRef, useState } from "react";
import { ArrowUpRight, ExternalLink } from "lucide-react";
import { useI18n, useSiteContent } from "../i18n";
import type { WorkItem } from "../content/site";
import { useNavigate } from "react-router-dom";

const useInView = (threshold = 0.1) => {
  const ref = useRef<HTMLDivElement>(null);
  const [inView, setInView] = useState(false);
  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const obs = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { setInView(true); obs.disconnect(); }
    }, { threshold });
    obs.observe(el);
    return () => obs.disconnect();
  }, [threshold]);
  return { ref, inView };
};

const WorkCard = ({ work, index, onClick }: { work: WorkItem; index: number; onClick: () => void }) => {
  const [hovered, setHovered] = useState(false);
  const cardRef = useRef<HTMLDivElement>(null);
  const [mousePos, setMousePos] = useState({ x: 0.5, y: 0.5 });

  const handleMouseMove = (e: React.PointerEvent) => {
    if (!cardRef.current) return;
    const r = cardRef.current.getBoundingClientRect();
    setMousePos({
      x: (e.clientX - r.left) / r.width,
      y: (e.clientY - r.top) / r.height,
    });
  };

  return (
    <div
      ref={cardRef}
      onClick={onClick}
      onMouseEnter={() => setHovered(true)}
      onMouseLeave={() => { setHovered(false); setMousePos({ x: 0.5, y: 0.5 }); }}
      onPointerMove={handleMouseMove}
      style={{
        flex: index === 1 ? "0 0 340px" : "0 0 280px",
        height: 400,
        borderRadius: 24,
        position: "relative",
        overflow: "hidden",
        cursor: "pointer",
        transform: hovered ? `translateY(-8px) scale(1.02)` : `translateY(0) scale(1)`,
        transition: "transform 0.4s cubic-bezier(0.22, 1, 0.36, 1)",
        boxShadow: hovered
          ? "0 24px 60px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.1)"
          : "0 8px 24px rgba(0,0,0,0.12), 0 0 0 1px rgba(255,255,255,0.04)",
        zIndex: hovered ? 10 : 1,
      }}
    >
      {/* 背景渐变 */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          background: work.gradient || "linear-gradient(135deg, #667eea, #764ba2)",
          opacity: 0.9,
        }}
      />

      {/* 背景图 */}
      {work.coverImage && (
        <div
          style={{
            position: "absolute",
            inset: 0,
            backgroundImage: `url(${work.coverImage})`,
            backgroundSize: "cover",
            backgroundPosition: "center",
            opacity: 0.3,
            transform: hovered ? "scale(1.05)" : "scale(1)",
            transition: "transform 0.6s ease, opacity 0.3s ease",
          }}
        />
      )}

      {/* 鼠标跟随光效 */}
      <div
        style={{
          position: "absolute",
          inset: -1,
          borderRadius: "inherit",
          background: `radial-gradient(300px 200px at ${mousePos.x * 100}% ${mousePos.y * 100}%, rgba(255,255,255,0.15), transparent 60%)`,
          opacity: hovered ? 1 : 0,
          transition: "opacity 0.3s ease",
          pointerEvents: "none",
          zIndex: 2,
        }}
      />

      {/* 内容 */}
      <div
        style={{
          position: "absolute",
          bottom: 0,
          left: 0,
          right: 0,
          padding: "22px 20px 20px",
          background: "linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%)",
          zIndex: 3,
        }}
      >
        <div style={{ color: "rgba(255,255,255,0.6)", fontSize: 11, marginBottom: 4, letterSpacing: "0.08em", textTransform: "uppercase" }}>
          {work.category} · {work.year}
        </div>
        <h3 style={{ color: "#fff", fontSize: 18, fontWeight: 700, marginBottom: 4, lineHeight: 1.2 }}>
          {work.title}
        </h3>
        <p style={{ color: "rgba(255,255,255,0.7)", fontSize: 12, lineHeight: 1.4, display: "-webkit-box", WebkitLineClamp: 2, WebkitBoxOrient: "vertical", overflow: "hidden" }}>
          {work.subtitle}
        </p>
        {work.award && (
          <div style={{ marginTop: 6, display: "inline-flex", alignItems: "center", gap: 4, background: "rgba(255,255,255,0.12)", padding: "3px 10px", borderRadius: 999, fontSize: 10, color: "rgba(255,255,255,0.85)" }}>
            🏆 {work.award}
          </div>
        )}
      </div>

      {/* 箭头指示 */}
      <div
        style={{
          position: "absolute",
          top: 18,
          right: 18,
          width: 32,
          height: 32,
          borderRadius: "50%",
          background: "rgba(255,255,255,0.1)",
          backdropFilter: "blur(8px)",
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          transform: hovered ? "translateX(2px) rotate(0deg)" : "translateX(0) rotate(0deg)",
          transition: "transform 0.3s ease",
          zIndex: 3,
        }}
      >
        <ArrowUpRight size={14} color="rgba(255,255,255,0.85)" />
      </div>
    </div>
  );
};

const Works = () => {
  const { lang } = useI18n();
  const siteContent = useSiteContent();
  const worksData = siteContent.works;
  const navigate = useNavigate();
  const [activeCategory, setActiveCategory] = useState(worksData.categories[0] || "全部");
  const [page, setPage] = useState(0);
  const { ref, inView } = useInView(0.05);

  const filteredWorks = useMemo(() => {
    if (activeCategory === worksData.categories[0]) return worksData.items;
    return worksData.items.filter((w) => w.category === activeCategory);
  }, [activeCategory, worksData]);

  const totalPages = Math.ceil(filteredWorks.length / 3);
  const pageWorks = filteredWorks.slice(page * 3, page * 3 + 3);

  const handleWorkClick = (work: WorkItem) => {
    if (work.slug) {
      navigate(`/works/${work.slug}`);
    } else if (work.caseHref) {
      window.open(work.caseHref, "_blank", "noopener,noreferrer");
    }
  };

  return (
    <section
      id="works"
      ref={ref}
      className="relative py-20 md:py-28"
      style={{ background: "var(--works-section-bg)", transition: "background 420ms" }}
    >
      <div
        className="mx-auto"
        style={{
          maxWidth: "var(--max-w-content)",
          paddingLeft: "var(--space-12)",
          paddingRight: "var(--space-12)",
        }}
      >
        {/* 标题 */}
        <div style={{ marginBottom: 32 }}>
          <span style={{ fontSize: "var(--text-xs)", letterSpacing: "0.15em", textTransform: "uppercase", color: "var(--muted-foreground)" }}>
            Portfolio
          </span>
          <h2 className="font-black" style={{ fontSize: "clamp(28px, 4vw, 48px)", marginTop: 4, background: "var(--title-gradient)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", backgroundClip: "text" }}>
            {lang === "en" ? "Featured Works" : "精选作品"}
          </h2>
        </div>

        {/* 分类按钮 */}
        <div style={{ display: "flex", flexWrap: "wrap", gap: 8, marginBottom: 36 }}>
          {worksData.categories.map((cat) => {
            const count = cat === worksData.categories[0]
              ? worksData.items.length
              : worksData.items.filter((w) => w.category === cat).length;
            const isActive = activeCategory === cat;
            return (
              <button
                key={cat}
                onClick={() => { setActiveCategory(cat); setPage(0); }}
                style={{
                  padding: "7px 20px",
                  borderRadius: 999,
                  fontSize: "var(--text-xs)",
                  fontWeight: isActive ? 600 : 400,
                  border: "1px solid",
                  borderColor: isActive ? "var(--primary)" : "var(--border)",
                  background: isActive ? "var(--primary)" : "transparent",
                  color: isActive ? "var(--primary-foreground)" : "var(--muted-foreground)",
                  cursor: "pointer",
                  transition: "all 0.25s ease",
                  letterSpacing: "0.03em",
                }}
              >
                {cat}
                <span style={{ marginLeft: 6, opacity: 0.6, fontSize: 10 }}>{count}</span>
              </button>
            );
          })}
        </div>

        {/* 三卡片区域 */}
        {pageWorks.length > 0 ? (
          <>
            <div
              style={{
                display: "flex",
                justifyContent: "center",
                alignItems: "flex-end",
                gap: 24,
                padding: "10px 0 20px",
                minHeight: 420,
              }}
            >
              {pageWorks.map((work, idx) => (
                <div
                  key={work.title}
                  style={{
                    opacity: inView ? 1 : 0,
                    transform: inView ? "translateY(0)" : "translateY(30px)",
                    transition: `opacity 0.6s ease ${idx * 0.12}s, transform 0.6s ease ${idx * 0.12}s`,
                  }}
                >
                  <WorkCard
                    work={work}
                    index={idx}
                    onClick={() => handleWorkClick(work)}
                  />
                </div>
              ))}
            </div>

            {/* 分页 */}
            {totalPages > 1 && (
              <div style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: 10, marginTop: 16 }}>
                {Array.from({ length: totalPages }).map((_, i) => (
                  <button
                    key={i}
                    onClick={() => setPage(i)}
                    style={{
                      width: i === page ? 28 : 8,
                      height: 8,
                      borderRadius: 4,
                      border: "none",
                      background: i === page ? "var(--primary)" : "var(--surface-3)",
                      cursor: "pointer",
                      transition: "all 0.3s ease",
                    }}
                  />
                ))}
              </div>
            )}
          </>
        ) : (
          <div style={{ textAlign: "center", padding: "60px 0", color: "var(--muted-foreground)", fontSize: "var(--text-sm)" }}>
            {worksData.emptyText}
          </div>
        )}

        {/* 查看更多 */}
        {filteredWorks.length > 0 && (
          <div style={{ display: "flex", justifyContent: "center", marginTop: 32 }}>
            <button
              onClick={() => handleWorkClick(filteredWorks[0])}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 8,
                padding: "10px 28px",
                borderRadius: 999,
                border: "1px solid var(--border)",
                background: "transparent",
                color: "var(--muted-foreground)",
                fontSize: "var(--text-sm)",
                cursor: "pointer",
                transition: "all 0.25s ease",
              }}
            >
              {worksData.loadMoreText}
              <ExternalLink size={13} />
            </button>
          </div>
        )}
      </div>
    </section>
  );
};

export default Works;
